{
  "name": "avaines.github.io",
  "version": "1.0.0",
  "description": "Vaines.org Portal Site",
  "main": "index.js",
  "repository": "https://github.com/avaines/avaines.github.io",
  "author": "Aiden Vaines",
  "license": "MIT",
  "scripts": {
    "start": "hugo server --disableFastRender",
    "build": "node scripts/testing/check-toolchain.js && hugo --environment production --gc --minify",
    "precommit": "pre-commit run --all-files",
    "syndicate": "node scripts/syndication/index.js --all",
    "syndicate:dry-run": "SYNDICATION_DRY_RUN=true node scripts/syndication/index.js --all",
    "syndicate:disable": "npm pkg set syndication.enabled=false",
    "syndicate:enable": "npm pkg set syndication.enabled=true",
    "test": "npm run test:all",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:unit": "jest scripts/syndication",
    "test:unit:coverage": "jest scripts/syndication --coverage",
    "test:all": "npm run test:unit && npm run test:sdk && npm run test:e2e",
    "test:sdk": "node --test scripts/testing/sdk.test.js",
    "test:external-links": "CHECK_EXTERNAL_LINKS=1 playwright test"
  },
  "dependencies": {
    "@atproto/api": "^0.22.0",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.6.1",
    "axios": "^1.20.0",
    "gray-matter": "^4.0.3",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.0",
    "remark-html": "^16.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "substack-api": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.4"
  },
  "browserslist": [
    "last 1 version",
    "> 1%",
    "maintained node versions",
    "not dead"
  ],
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "dotenv": "^18.0.5",
    "jest": "^30.5.2",
    "nock": "^14.0.17",
    "postcss": "^8.5.28"
  },
  "syndication": {
    "enabled": true,
    "baseUrl": "https://www.vaines.org",
    "targets": {
      "bluesky": {
        "enabled": true
      },
      "devto": {
        "enabled": true
      },
      "mastodon": {
        "enabled": true
      },
      "substack": {
        "enabled": true
      }
    },
    "defaults": {
      "delay": 0,
      "canonicalNote": "Originally published at {{url}}",
      "maxRetries": 3,
      "retryDelay": 5000
    }
  },
  "engines": {
    "node": ">=22.0.0 <23"
  }
}
